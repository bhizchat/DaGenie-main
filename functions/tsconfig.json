{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Node",
    "outDir": "lib",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "src/index.ts",
    "src/saveStoryboardSet.ts",
    "src/startStoryboardRun.ts",
    "src/enqueueSceneVideo.ts",
    "src/runSceneVideo.ts",
    "src/wanI2VFast.ts",
    "src/utils/storageHelpers.ts",
    "src/musicVideo/generateFluxAvatar.ts",
    "src/musicVideo/generateMusicStoryboard.ts"
  ]
}
